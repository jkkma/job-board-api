{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // rootDir is the project root rather than src/ so the seed script is
    // compiled alongside the app and ends up in the image. Output is therefore
    // dist/src/server.js and dist/prisma/seed.js.
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "prisma/seed.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
