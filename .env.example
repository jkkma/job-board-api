# Copy to .env and fill in. Every variable here is parsed and validated at boot
# by src/config/env.ts — the server refuses to start if any of them is invalid.

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_board?schema=public"

# Signing key for access tokens. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
JWT_SECRET="replace-me-with-at-least-32-random-characters"

# --- Optional (defaults shown) ----------------------------------------------

NODE_ENV=development
PORT=5000

# How long an access token stays valid (zeit/ms format: 15m, 12h, 7d).
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins.
# Leave unset in development to allow any origin.
# CORS_ORIGIN=https://your-frontend.example.com,https://staging.example.com

# bcrypt work factor. 10 is a sane production value; the test suite drops it
# to 4 because hashing at cost 10 adds ~60ms to every register call.
BCRYPT_ROUNDS=10

# Auth rate limiting: max requests per window, per IP.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Number of reverse proxies in front of the app, used to resolve the client IP
# for rate limiting. 0 = no proxy (running directly). Set to 1 behind a single
# load balancer such as Render, Railway, Fly, or Heroku.
# This must be an exact hop count and never `true`: trusting X-Forwarded-For
# unconditionally lets a client spoof its own IP and bypass the rate limiter.
TRUST_PROXY_HOPS=0

# --- Tests only -------------------------------------------------------------
# Used by the Vitest suite. Must point at a database whose name contains
# "test" — tests/setup.ts refuses to truncate anything else.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_board_test?schema=public"
