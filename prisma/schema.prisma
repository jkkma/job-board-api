generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(APPLICANT)
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs         Job[] // employer posts these
  applications Application[]

  @@map("users")
}

model Job {
  id          String @id @default(uuid())
  title       String
  description String
  location    String?

  // Stored as integers rather than a free-form string so the listing endpoint
  // can filter on a range. `salaryMin`/`salaryMax` are the advertised band.
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String @default("USD")

  // Employment type and work location are orthogonal — a role can be both
  // FULL_TIME and REMOTE — so they are separate fields rather than the single
  // free-form `type` string this replaced.
  type     JobType?
  workMode WorkMode?

  isActive Boolean @default(true)

  employerId String
  employer   User   @relation(fields: [employerId], references: [id], onDelete: Cascade)

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Matches the access path of the listing query: filter on isActive, order by
  // createdAt descending.
  @@index([isActive, createdAt(sort: Desc)])
  @@index([employerId])
  @@map("jobs")
  // Note: there is deliberately no index on `title`/`description`. The search
  // filter uses `contains` (ILIKE '%term%'), which a btree index cannot serve.
  // Making that query indexed needs a pg_trgm GIN index — see the README.
}

enum Role {
  EMPLOYER
  APPLICANT
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

model Application {
  id          String @id @default(uuid())
  coverLetter String?
  status      Status @default(PENDING)

  applicantId String
  applicant   User   @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevents duplicate applications, and doubles as the index for
  // "applications by this applicant" — a leading-column prefix of the unique
  // index — so no separate @@index([applicantId]) is needed.
  @@unique([applicantId, jobId])
  // Employer-facing lookup ("all applications for this job") has no such
  // covering index, so it gets its own.
  @@index([jobId])
  @@map("applications")
}

enum Status {
  PENDING
  ACCEPTED
  REJECTED
}
